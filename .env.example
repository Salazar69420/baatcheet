# --- Required -------------------------------------------------------------
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Transcription ----------------------------------------------------------
# Any OpenRouter model that accepts audio input. Check the exact id at https://openrouter.ai/models
MODEL=google/gemini-3.1-flash-lite
# Each speaker's audio is cut into standalone chunks of this many seconds.
# Shorter = faster live transcript, longer = better context/accuracy.
CHUNK_SECONDS=15
# How many chunks are sent to the model at the same time.
TRANSCRIBE_CONCURRENCY=2
# Chunks whose loudest moment is quieter than this (dBFS) are skipped as silence.
SILENCE_THRESHOLD_DB=-45

# --- Server -----------------------------------------------------------------
PORT=3000
# Keep 127.0.0.1 and expose the app with `tailscale serve`. Docker sets 0.0.0.0 internally.
HOST=127.0.0.1
DATA_DIR=./data
# FFMPEG_PATH=ffmpeg

# --- WebRTC -----------------------------------------------------------------
# Comma separated. Over Tailscale calls connect directly, so STUN is plenty.
STUN_URLS=stun:stun.l.google.com:19302
# Optional TURN relay (only needed outside Tailscale on strict networks)
# TURN_URLS=turn:turn.example.com:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=
